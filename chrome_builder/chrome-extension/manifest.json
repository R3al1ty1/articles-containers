{
  "manifest_version": 2,
  "name": "Scopus UI Cleaner (MV2)",
  "version": "1.1",
  "description": "Removes specific header elements from the Scopus website.",

  "content_scripts": [
    {
      "matches": [
        "https://*.scopus.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],

  "permissions": [
    "https://*.scopus.com/*"
  ]
}