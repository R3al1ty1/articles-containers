<?xml version="1.0" encoding="UTF-8"?>
<openbox_config xmlns="http://openbox.org/3.4/rc">
  <keyboard>
    <keybind key="F12">
      <action name="Execute">
        <command>echo "F12 disabled"</command>
      </action>
    </keybind>
    <keybind key="C-S-i">
      <action name="Execute">
        <command>echo "Ctrl+Shift+I disabled"</command>
      </action>
    </keybind>
    <keybind key="C-S-j">
      <action name="Execute">
        <command>echo "Ctrl+Shift+J disabled"</command>
      </action>
    </keybind>
    <keybind key="C-S-c">
      <action name="Execute">
        <command>echo "Ctrl+Shift+C disabled"</command>
      </action>
    </keybind>
  </keyboard>
</openbox_config>