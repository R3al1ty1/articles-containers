<?xml version="1.0" encoding="UTF-8"?>
<openbox_config xmlns="http://openbox.org/3.4/rc">
  <keyboard>
    <chainQuitKey>C-g</chainQuitKey>
  </keyboard>
  <mouse>
    <context name="Root">
      <mousebind button="Right" action="Press">
        <action name="ShowMenu">
          <menu>root-menu</menu>
        </action>
      </mousebind>
    </context>
  </mouse>
  <menu>
    <item label="English Layout">
      <action name="Execute">
        <command>setxkbmap -layout us</command>
      </action>
    </item>
    <item label="Russian Layout">
      <action name="Execute">
        <command>setxkbmap -layout ru</command>
      </action>
    </item>
    <separator/>
    <item label="Terminal (xterm)">
        <action name="Execute">
            <command>xterm</command>
        </action>
    </item>
  </menu>
</openbox_config>